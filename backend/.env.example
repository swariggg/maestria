# Configuración de Entorno de Ejemplo - APP Maestría UIDE
PROJECT_NAME="APP - Maestría UIDE"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true

# Base de Datos SQL Server 2022/2025 Local
SQLSERVER_SERVER="localhost"
SQLSERVER_DATABASE="app_maestria"
SQLSERVER_DRIVER="ODBC Driver 18 for SQL Server"
SQLSERVER_TRUSTED_CONNECTION="yes"
SQLSERVER_TRUST_CERTIFICATE="yes"
DATABASE_URL="mssql+pyodbc:///?odbc_connect=DRIVER%3D%7BODBC+Driver+18+for+SQL+Server%7D%3BServer%3Dlocalhost%3BDatabase%3Dapp_maestria%3BTrusted_Connection%3Dyes%3BTrustServerCertificate%3Byes%3B"

# Seguridad y JWT
SECRET_KEY="cambiar_por_una_clave_secreta_robusta_en_produccion"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Almacenamiento Privado Seguro
STORAGE_DIR="storage/private"
MAX_UPLOAD_SIZE_MB=50

# Notificaciones y SMTP (true = modo simulación local sin enviar a internet)
SMTP_TEST_MODE=true
SMTP_SERVER="smtp.uide.edu.ec"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="maestrias.admision@uide.edu.ec"

# Parámetros Académicos
DIAS_INACTIVIDAD_RIESGO=7
INTENTOS_SIN_RESPUESTA_ALERTA=2
TIMEZONE="America/Guayaquil"
